<!-- Interactive JavaScript for Conversational Simulator & Microphone State -->
<script>
    (function initSmartStockVoiceConcierge() {
      const micBtn = document.getElementById('main-mic-btn');
      const chatInput = document.getElementById('chat-input');
      const sendBtn = document.getElementById('send-btn');
      const thread = document.getElementById('chat-thread');
      let isRecording = false;

      // Microphone Pulse Simulation
      if (micBtn) {
        micBtn.addEventListener('click', function() {
          isRecording = !isRecording;
          if (isRecording) {
            micBtn.classList.add('bg-error');
            micBtn.classList.remove('bg-primary');
            chatInput.placeholder = "Listening closely in Hindi / English / Tamil... Speak now";
          } else {
            micBtn.classList.remove('bg-error');
            micBtn.classList.add('bg-primary');
            chatInput.placeholder = "Ask anything about stock, suppliers, or speak your command (Hold Space to speak)...";
          }
        });
      }

      // Quick Send Function
      function appendUserMessage(text) {
        if (!text || !text.trim()) return;

        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        
        // User bubble
        const userDiv = document.createElement('div');
        userDiv.className = 'flex flex-col items-end gap-1.5 max-w-xl self-end transition-all';
        userDiv.innerHTML = `
          <div class="flex items-center gap-2">
            <span class="font-label-sm text-label-sm text-outline">${time}</span>
          </div>
          <div class="p-4 rounded-xl rounded-tr-none bg-surface-container-high text-on-surface shadow-sm">
            <p class="font-body-md text-body-md">${text}</p>
          </div>
        `;
        thread.appendChild(userDiv);
        chatInput.value = '';

        // Synthetic AI response
        setTimeout(function() {
          const aiDiv = document.createElement('div');
          aiDiv.className = 'flex flex-col items-start gap-2 max-w-2xl self-start w-full transition-all';
          aiDiv.innerHTML = `
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary">
                <span class="material-symbols-outlined text-[14px] text-secondary-fixed">auto_awesome</span>
              </div>
              <span class="font-label-sm text-label-sm text-primary font-semibold">Concierge Intelligence</span>
              <span class="font-label-sm text-label-sm text-outline">• ${time}</span>
              <span class="px-1.5 py-0.5 rounded bg-secondary-container text-on-secondary-container font-label-sm text-[10px] font-bold">SYNCHRONIZED</span>
            </div>
            <div class="p-5 rounded-xl rounded-tl-none bg-surface-container-low text-on-surface shadow-sm flex flex-col gap-3 w-full">
              <p class="font-body-md text-body-md leading-relaxed">
                Ledger reconciled for <strong>"${text}"</strong>. Verified with inventory databases. Would you like me to commit this entry to the central tally or ping the store supervisor on WhatsApp?
              </p>
              <div class="flex items-center gap-2">
                <button type="button" class="px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md shadow-sm">Commit Transaction</button>
                <button type="button" class="px-3 py-1.5 rounded-lg bg-surface-container-high text-primary font-label-md text-label-md">WhatsApp to Staff</button>
              </div>
            </div>
          `;
          thread.appendChild(aiDiv);
          thread.scrollTop = thread.scrollHeight;
        }, 700);

        thread.scrollTop = thread.scrollHeight;
      }

      if (sendBtn && chatInput) {
        sendBtn.addEventListener('click', function() {
          appendUserMessage(chatInput.value);
        });

        chatInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            appendUserMessage(chatInput.value);
          }
        });
      }

      // Language Switcher Visual Toggle
      const langs = ['lang-en', 'lang-hi', 'lang-ta'];
      langs.forEach(function(id) {
        const btn = document.getElementById(id);
        if (btn) {
          btn.addEventListener('click', function() {
            langs.forEach(otherId => {
              const other = document.getElementById(otherId);
              if (other) {
                other.className = 'px-2.5 py-1 rounded text-label-sm font-label-sm text-on-surface-variant hover:text-on-surface transition-all';
              }
            });
            btn.className = 'px-2.5 py-1 rounded text-label-sm font-label-sm bg-primary text-on-primary transition-all';
          });
        }
      });
    })();
  </script>
