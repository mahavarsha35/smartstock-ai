    function simulateScan() {
      const input = document.getElementById('barcodeMockInput');
      const randomSkus = [
        { code: '8901030383742', label: 'Surf Excel 1kg [HUL-SRF-01]' },
        { code: '8901262010053', label: 'Amul Taaza 1L [AML-MLK-01]' },
