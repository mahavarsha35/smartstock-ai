          <p class="font-body-md text-body-md">${text}</p>
        </div>
      `;
      thread.appendChild(userDiv);

      // Scroll smoothly to latest
      thread.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Simulate AI response
      cycleOrbState(); // thinking state
      setTimeout(() => {
        cycleOrbState(); // speaking state
        const aiDiv = document.createElement('div');
        aiDiv.className = 'flex flex-col items-start gap-2 max-w-2xl self-start w-full transition-all';
        aiDiv.innerHTML = `
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm">
              <span class="material-symbols-outlined text-[14px] text-secondary-fixed">auto_awesome</span>
