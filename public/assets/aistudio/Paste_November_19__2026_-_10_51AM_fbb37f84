      ];
      const pick = randomSkus[Math.floor(Math.random() * randomSkus.length)];
      input.value = pick.code;
      
      // Auto-flash visual confirmation
      input.classList.add('bg-secondary-fixed');
      setTimeout(() => {
        input.classList.remove('bg-secondary-fixed');
        alert('Scan Captured: ' + pick.label + '\\nReady to record inward or sales transaction.');
      }, 350);
    }

    function commitStockIn() {
      const skuSelect = document.getElementById('stockInSku');
      const skuText = skuSelect.options[skuSelect.selectedIndex].text.split('[')[0];
      const qty = document.getElementById('inQty').value;
      const inv = document.getElementById('inInvoice').value;
      
      prependRow({
