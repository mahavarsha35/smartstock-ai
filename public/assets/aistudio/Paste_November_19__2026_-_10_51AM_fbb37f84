<!-- Interactive Logic for Ambient Voice Controls -->
<script>
    let isMuted = false;
    let voiceStateIndex = 0;
    const states = [
      { name: "Listening...", title: "Ambient Voice Stream", icon: "mic", badgeColor: "bg-secondary", orbGradient: "from-[#715b33] via-[#dfc392] to-[#fddfab]" },
      { name: "Neural Thinking...", title: "Synthesizing Intent...", icon: "psychology", badgeColor: "bg-blue-400", orbGradient: "from-blue-700 via-indigo-400 to-[#fddfab]" },
      { name: "Speaking...", title: "Voice Audio Responding", icon: "volume_up", badgeColor: "bg-emerald-500", orbGradient: "from-emerald-700 via-teal-400 to-[#dfc392]" }
    ];

    function toggleAmbientBar() {
      const bar = document.getElementById('ambient-voice-container');
      const reopenBtn = document.getElementById('reopen-ambient-btn');
      if (bar.classList.contains('hidden')) {
        bar.classList.remove('hidden');
        reopenBtn.classList.add('hidden');
      } else {
        bar.classList.add('hidden');
        reopenBtn.classList.remove('hidden');
      }
    }

    function toggleMute() {
      isMuted = !isMuted;
      const muteIcon = document.getElementById('ambient-mute-icon');
      const stateBadge = document.getElementById('ambient-state-badge');
      if (isMuted) {
        muteIcon.textContent = "mic_off";
        muteIcon.classList.add("text-error");
        stateBadge.textContent = "Muted";
      } else {
        muteIcon.textContent = "mic";
        muteIcon.classList.remove("text-error");
        stateBadge.textContent = "Listening...";
      }
    }

    function cycleOrbState() {
      voiceStateIndex = (voiceStateIndex + 1) % states.length;
      const cur = states[voiceStateIndex];
      document.getElementById('ambient-state-badge').textContent = cur.name;
      document.getElementById('voice-state-title').textContent = cur.title;
      document.getElementById('orb-icon').textContent = cur.icon;
    }

    function setLanguage(btn, langCode) {
      const parent = btn.parentElement;
      Array.from(parent.children).forEach(child => {
        child.className = "px-2 py-1 rounded text-[#f2dfd3] hover:text-white transition-colors text-label-sm";
      });
      btn.className = "px-2 py-1 rounded bg-[#fddfab] text-primary font-semibold text-label-sm";
    }

    function presetVoiceQuery(text) {
      document.getElementById('transcription-stream').innerHTML = `“${text}”`;
      const input = document.getElementById('chat-input');
      if (input) input.value = text;
    }

    function sendVoiceTranscript() {
      const streamText = document.getElementById('transcription-stream').innerText.replace(/[“”"]/g, '').trim();
      if (!streamText) return;
      appendUserMessage(streamText);
    }

    function appendUserMessage(text) {
      const thread = document.getElementById('chat-thread');
      if (!thread || !text) return;

      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      // Append User message
      const userDiv = document.createElement('div');
      userDiv.className = 'flex flex-col items-end gap-1.5 max-w-xl self-end transition-all';
      userDiv.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm font-numeric-data">
            <span class="material-symbols-outlined text-[13px] text-secondary">mic</span>
            Transcribed Ambiently
          </span>
          <span class="font-label-sm text-label-sm text-outline">${time}</span>
        </div>
        <div class="p-4 rounded-xl rounded-tr-none bg-surface-container-high text-on-surface shadow-sm border border-outline-variant/20">
          <p class="font-body-md text-body-md">${text}</p>
        </div>
      `;
      thread.appendChild(userDiv);

      // Scroll smoothly to latest
      thread.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Simulate AI response
      cycleOrbState(); // thinking state
      setTimeout(() => {
        cycleOrbState(); // speaking state
        const aiDiv = document.createElement('div');
        aiDiv.className = 'flex flex-col items-start gap-2 max-w-2xl self-start w-full transition-all';
        aiDiv.innerHTML = `
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-on-primary shadow-sm">
              <span class="material-symbols-outlined text-[14px] text-secondary-fixed">auto_awesome</span>
            </div>
            <span class="font-label-sm text-label-sm text-primary font-semibold">Concierge Intelligence</span>
            <span class="font-label-sm text-label-sm text-outline">• ${time}</span>
            <span class="px-2 py-0.5 rounded bg-secondary-container text-on-secondary-container font-label-sm text-[10px] font-bold">SYNCHRONIZED</span>
          </div>
          <div class="p-5 rounded-xl rounded-tl-none bg-surface-container-low text-on-surface shadow-sm flex flex-col gap-3 w-full border border-outline-variant/30">
            <p class="font-body-md text-body-md leading-relaxed">
              Order request processed for <strong>"${text}"</strong>. Stock levels verified across backroom rack B2. I have registered the dispatch alert with the supplier ledger.
            </p>
            <div class="flex items-center gap-2 pt-1">
              <button type="button" class="px-3.5 py-1.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md shadow-sm active:scale-95">Commit Transaction</button>
              <button type="button" class="px-3.5 py-1.5 rounded-lg bg-surface-container-high text-primary font-label-md text-label-md active:scale-95">Send WhatsApp Notification</button>
            </div>
          </div>
        `;
        thread.appendChild(aiDiv);

        setTimeout(() => {
          cycleOrbState(); // return to listening
        }, 1800);
      }, 900);
    }

    // Connect text chat input and send button
    document.addEventListener('DOMContentLoaded', () => {
      const sendBtn = document.getElementById('send-btn');
      const chatInput = document.getElementById('chat-input');
      if (sendBtn && chatInput) {
        sendBtn.addEventListener('click', () => {
          if (chatInput.value.trim()) {
            appendUserMessage(chatInput.value.trim());
            chatInput.value = '';
          }
        });
        chatInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            if (chatInput.value.trim()) {
              appendUserMessage(chatInput.value.trim());
              chatInput.value = '';
            }
          }
        });
      }
    });
  </script>
</body></html>

